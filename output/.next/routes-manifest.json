{
  "version": 3,
  "pages404": true,
  "appType": "app",
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "priority": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    }
  ],
  "headers": [
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "private, no-cache, no-store, max-age=0, must-revalidate"
        }
      ],
      "regex": "^/(?:/)?$"
    },
    {
      "source": "/screen",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "private, no-cache, no-store, max-age=0, must-revalidate"
        }
      ],
      "regex": "^/screen(?:/)?$"
    }
  ],
  "onMatchHeaders": [],
  "rewrites": {
    "beforeFiles": [],
    "afterFiles": [],
    "fallback": []
  },
  "dynamicRoutes": [
    {
      "page": "/api/drive/file/[fileId]",
      "regex": "^/api/drive/file/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPfileId": "nxtPfileId"
      },
      "namedRegex": "^/api/drive/file/(?<nxtPfileId>[^/]+?)(?:/)?$"
    }
  ],
  "staticRoutes": [
    {
      "page": "/",
      "regex": "^/(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/(?:/)?$"
    },
    {
      "page": "/_global-error",
      "regex": "^/_global\\-error(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_global\\-error(?:/)?$"
    },
    {
      "page": "/_not-found",
      "regex": "^/_not\\-found(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_not\\-found(?:/)?$"
    },
    {
      "page": "/api/drive/configure",
      "regex": "^/api/drive/configure(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/drive/configure(?:/)?$"
    },
    {
      "page": "/api/drive/playlist",
      "regex": "^/api/drive/playlist(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/drive/playlist(?:/)?$"
    },
    {
      "page": "/api/drive/settings",
      "regex": "^/api/drive/settings(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/drive/settings(?:/)?$"
    },
    {
      "page": "/api/drive/status",
      "regex": "^/api/drive/status(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/drive/status(?:/)?$"
    },
    {
      "page": "/api/drive/upload",
      "regex": "^/api/drive/upload(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/drive/upload(?:/)?$"
    },
    {
      "page": "/api/google/oauth/callback",
      "regex": "^/api/google/oauth/callback(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/google/oauth/callback(?:/)?$"
    },
    {
      "page": "/api/google/oauth/start",
      "regex": "^/api/google/oauth/start(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/google/oauth/start(?:/)?$"
    },
    {
      "page": "/api/youtube/title",
      "regex": "^/api/youtube/title(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/youtube/title(?:/)?$"
    },
    {
      "page": "/favicon.ico",
      "regex": "^/favicon\\.ico(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/favicon\\.ico(?:/)?$"
    },
    {
      "page": "/screen",
      "regex": "^/screen(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/screen(?:/)?$"
    }
  ],
  "dataRoutes": [],
  "rsc": {
    "header": "rsc",
    "varyHeader": "rsc, next-router-state-tree, next-router-prefetch, next-router-segment-prefetch",
    "prefetchHeader": "next-router-prefetch",
    "didPostponeHeader": "x-nextjs-postponed",
    "contentTypeHeader": "text/x-component",
    "suffix": ".rsc",
    "prefetchSegmentHeader": "next-router-segment-prefetch",
    "prefetchSegmentSuffix": ".segment.rsc",
    "prefetchSegmentDirSuffix": ".segments",
    "clientParamParsing": false,
    "dynamicRSCPrerender": false
  },
  "rewriteHeaders": {
    "pathHeader": "x-nextjs-rewritten-path",
    "queryHeader": "x-nextjs-rewritten-query"
  }
}